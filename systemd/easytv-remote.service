[Unit]
Description=EasyTV remote input
PartOf=easytv.service
BindsTo=easytv.service
After=easytv.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=easytv
Group=easytv
Environment=HOME=/var/lib/easytv
WorkingDirectory=/var/lib/easytv
UMask=0077
ExecStart=/etc/easytv/easytv-remote.exs --url http://127.0.0.1:8080
Restart=always
RestartSec=5s
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
